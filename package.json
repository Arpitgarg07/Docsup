{
  "name": "docsup",
  "private": true,
  "version": "0.1.0",
  "description": "Docsup — your family's documents, securely organized.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @docsup/web",
    "build": "npm run build --workspace @docsup/web",
    "start": "npm run start --workspace @docsup/web",
    "lint": "npm run lint --workspace @docsup/web",
    "typecheck": "npm run typecheck --workspace @docsup/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "storage:setup": "tsx scripts/appwrite-setup.ts",
    "test:email": "node --conditions=react-server --import tsx --test scripts/test-email-otp.cjs",
    "test:onboarding": "node scripts/test-onboarding.cjs",
    "test:onboarding:api": "node scripts/test-onboarding-api.cjs",
    "test:search": "node scripts/test-search.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.4.2",
  "devDependencies": {
    "dotenv": "^18.0.5"
  }
}
