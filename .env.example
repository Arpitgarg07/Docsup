# Copy to .env and fill locally. Never commit real credentials.
DATABASE_URL=""
APP_URL="http://localhost:3000"
SESSION_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server-only email OTP delivery. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""

# Existing server-only Appwrite storage configuration
APPWRITE_ENDPOINT=""
APPWRITE_PROJECT_ID=""
APPWRITE_API_KEY=""
APPWRITE_BUCKET_ID=""

# Existing optional AI configuration (not required for email sign-in)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Optional; email OTP does not require Redis or Docker.
REDIS_URL=""
